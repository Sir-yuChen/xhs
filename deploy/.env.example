# 服务器部署环境变量（v1.1.0）
#
# 用法：cp deploy/.env.example .env  → 填两个密码 → docker compose up -d
#
# ⚠️ **必须填的两项**：不填则 `docker compose up` 直接报错退出
#    （compose 的 `:?` 语法 + 应用侧的安全自检，两道拦截）。

# ── 应用密钥（必填）─────────────────────────────────────────────
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
# ⚠️ 留空或保持默认值 ⇒ 应用拒绝启动（设计 53 C1）。
#    用默认密钥签发的 JWT 等于任何人都能伪造登录态。
SECRET_KEY=

# ── 数据库（必填）────────────────────────────────────────────────
POSTGRES_DB=spider_xhs
POSTGRES_USER=spider_xhs
POSTGRES_PASSWORD=

# ── 对外端口 ────────────────────────────────────────────────────
# nginx 监听端口。80 被占用时改成 8080（改完访问 http://IP:8080）。
HTTP_PORT=80
