# ============ git 上传策略（2026-09-24 v1.0 首次提交时确定） ============

# 真实数据库与全部本地备份（data/*.db、data/*.bak-*、*.bak、*.bak-*）
data/
*.bak
*.bak-*

# PyInstaller 构建用虚拟环境（几百 MB，.venv 模板规则匹配不到 .venv-build）
.venv-build/

# 本地真机快照（openapi 实测导出，非协作文档）
openapi_live.json

# 桌面安装包产物
spider-xhs-setup-*.exe

# PyInstaller 的 .spec 是手写配置（源码），放行——模板的 *.spec 会误伤它
!packaging/SpiderXHS.spec

# .workbuddy 整体不上云（2026-09-25 用户口径）：本地规范 / 记忆 / 脚本 / 过程件
# 均属本地资产，远程仓库只放业务源码、测试、文档。
/.workbuddy/

# .hermes 整体不上云（2026-10-05 由 .workbuddy 迁移而来：项目改用 Hermes 开发，
# 本地规范 / 脚本 / 技能 / 日志都在这里；原 .workbuddy 已移除）
/.hermes/

# author/：只保留 README 引用的 logo.jpg；其余为个人二维码 / 社交 / 打赏码
author/*
!author/logo.jpg

# 系统 / 编辑器
Thumbs.db
.DS_Store

# 用户素材目录（运行时数据：本地素材库根）—— 不进版本库
# ⚠️ 2026-10-03 发现：SCK/ 下 6 个文件被跟踪 ⇒ 用户在页面删一张图就会产生假 diff，
#    且素材是二进制大图（单张 6.5MB）。素材属于**运行时数据**，与 data/ 同类。
SCK/

#: ⚠️ 开发临时件（2026-10-15 加）：一次性探针脚本 + 空的 dev 目录。
#: 发版前 `release.ps1` 要求工作区干净 ⇒ 这类东西不进库，免得到处 `git add .` 时被卷进来。
/probe_*.py
dev/
frontend/dev/
#: ⚠️ 打包脚本的 Python 临时件（2026-10-15 加）：build.ps1 把两段 Python
#: （读源码版本历史 / 包内自检）写成临时文件再跑 —— 因为 PS 5.1 用 `-c` 传
#: 含中文的代码会被控制台代码页破坏。属于**构建中间产物**，不进库。
/packaging/.py-tmp/
